# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.
GEMINI_API_KEY=your-google-ai-studio-key
# Optional: fast model for map annotations (default gemini-3.5-flash-lite)
# GEMINI_ANNOTATE_MODEL=
# Optional: model for frame/fire analysis (default gemini-3.8-flash)
# GEMINI_MODEL=
# Keep per-frame fire analysis local so Gemini quota/latency goes to map annotations (default 'auto' calls Gemini whenever a key is set)
FIRESIGHT_DETECTOR=opencv
